# PIETRAx API — environment configuration template.
# Copy to server/.env and fill in real values. Never commit server/.env.

# --- Database ---------------------------------------------------------------
# Postgres connection string. Local example (native PG15 role/db from setup):
DATABASE_URL="postgresql://pietrax:pietrax_local_dev@127.0.0.1:5432/pietrax"
# Docker alternative (uses docker-compose.yml at repo root):
# DATABASE_URL="postgresql://pietrax:pietrax_local_dev@127.0.0.1:5433/pietrax"

# --- Runtime ----------------------------------------------------------------
# development | production
APP_ENV=development
PORT=4000

# --- Secrets (generate with: openssl rand -hex 32) --------------------------
# Production requires >= 32 chars. CSRF falls back to SESSION_SECRET if unset.
SESSION_SECRET="replace-with-64-hex-chars"
CSRF_SECRET="replace-with-64-hex-chars"

# --- Sessions ---------------------------------------------------------------
SESSION_IDLE_TTL_MINUTES=60
SESSION_ABS_TTL_HOURS=12
# Production: set to your domain (e.g. .pietra.example) and true.
COOKIE_DOMAIN=
COOKIE_SECURE=false
TRUST_PROXY=false

# --- App --------------------------------------------------------------------
# Origin that may call this API directly (comma-separated for multiple).
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
# Path of the built SPA (root dist/ is the default).
CLIENT_DIST_DIR=../dist
# Admin SPA is only shown when $admin_enabled in the route config is true.
ADMIN_SCRIPT_PATH=/admin

# --- Uploads ----------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=12582912